{
  "name": "campustrade",
  "version": "0.1.0",
  "private": true,
  "description": "CampusTrade - single-college verified student marketplace (Team SyncTrade P8)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset:test": "tsx --env-file=.env scripts/reset-test-db.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "tsx --env-file=.env scripts/reset-test-db.ts && vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "perf:seed": "tsx --env-file=.env scripts/perf-seed.ts",
    "perf:run": "tsx --env-file=.env scripts/perf-run.ts",
    "typegen": "next typegen",
    "monitor": "tsx scripts/monitor.ts",
    "recovery:check": "tsx --env-file=.env scripts/verify-recovery.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.18",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "next": "16.4.5",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "mailparser": "^3.14.2",
    "prisma": "7.10.1",
    "smtp-server": "^3.21.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
