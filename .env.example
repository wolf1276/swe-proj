# CampusTrade environment template.
# Copy to .env for local development. Never commit real credentials.
#
# All values below are LOCAL DEVELOPMENT defaults using reserved
# documentation-only values (RFC 2606: .example). They are not real
# credentials and must never be used for real student data.

# PostgreSQL connection string. The local docker-compose.yml starts
# postgres with the matching local development credentials.
DATABASE_URL="postgresql://campustrade:campustrade-local-dev@localhost:5432/campustrade?schema=public"

# Canonical origin of the application (no trailing slash).
APP_URL="http://localhost:3000"

# Secret used by Better Auth for token hashing/encryption.
# Generate with: openssl rand -base64 32
# Required in production; must be at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-generated-secret-at-least-32-chars"

# Comma-separated allowlist of approved campus email domains.
# Exact domain match only (no suffix matching). These are the synthetic
# local-development domains; obtain the real institutional allowlist
# before any real student access (decision D04).
APPROVED_DOMAINS="campus.example"

# Mail adapter: "sink" (development only) or "smtp".
# Production rejects "sink" and requires SMTP configuration.
MAIL_ADAPTER="sink"

# Directory where the development mail sink writes captured messages.
MAIL_SINK_DIR=".mailsink"

# SMTP connection URL used when MAIL_ADAPTER=smtp (e.g. staging/production).
# Example: SMTP_URL="smtp://user:pass@smtp.example.com:587"
SMTP_URL=""

# Synthetic password for locally seeded demo accounts (development only).
DEV_SEED_PASSWORD="local-seed-pass-1234"

# Isolated local tests; never point this at development or production data.
TEST_DATABASE_URL="postgresql://campustrade:campustrade-local-dev@localhost:5432/campustrade_test?schema=public"
# Required for SMTP; use a verified sender for your provider.
SMTP_FROM=""
